:root {
  color-scheme: dark;
  --bg: #061121;
  --bg-soft: #091a2f;
  --panel: rgba(12, 31, 55, .78);
  --card: rgba(14, 36, 64, .72);
  --card-strong: rgba(17, 46, 82, .9);
  --card-border: rgba(118, 163, 218, .18);
  --border: rgba(148, 163, 184, .18);
  --text: #f8fbff;
  --muted: #91a5bf;
  --primary: #3b82f6;
  --primary-dark: #1d4ed8;
  --success: #22c55e;
  --warning: #f59e0b;
  --danger: #ef4444;
  --gold: #eab308;
  --cyan: #06b6d4;
  --shadow: 0 22px 70px rgba(1, 8, 20, .34);
  --glow: 0 0 0 1px rgba(96, 165, 250, .14), 0 22px 70px rgba(15, 23, 42, .32);
  --radius: 20px;
}
* { box-sizing: border-box; }
html { min-height: 100%; background: var(--bg); }
body {
  margin: 0;
  min-height: 100vh;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background:
    radial-gradient(circle at 20% 0%, rgba(37, 99, 235, .22), transparent 26%),
    radial-gradient(circle at 90% 10%, rgba(6, 182, 212, .14), transparent 24%),
    linear-gradient(135deg, #020817 0%, #061121 42%, #071a2e 100%);
  color: var(--text);
}
a { color: inherit; text-decoration: none; }
button, input, select, textarea { font: inherit; }
button { color: inherit; }
::selection { background: rgba(59,130,246,.34); }

.loading-page, .login-page { min-height: 100vh; display: grid; place-items: center; padding: 24px; }
.loading-page { background: var(--bg); color: var(--text); }
.login-page { background: radial-gradient(circle at top left, rgba(59,130,246,.32), transparent 32%), linear-gradient(135deg, #020817, #0b2a52 48%, #0f56a3); }
.login-card {
  width: min(100%, 420px);
  background: rgba(255,255,255,.96);
  color: #0f172a;
  border-radius: 28px;
  padding: 32px;
  box-shadow: var(--shadow);
  display: grid;
  gap: 12px;
}
.login-card h1, .login-card h2 { margin: 0; font-size: 28px; letter-spacing: -.03em; }
.login-card p { color: #64748b; margin-top: 0; }
.login-icon { width: 70px; height: 70px; border-radius: 22px; display: grid; place-items: center; background: #eff6ff; color: var(--primary); }
.login-brand-logo { width: 142px; height: 58px; margin: 0 auto 12px; display: flex; align-items: center; justify-content: center; border-radius: 18px; background: #ffffff; box-shadow: 0 16px 40px rgba(15,23,42,.12); padding: 10px 14px; }
.login-brand-logo img { max-width: 100%; max-height: 100%; object-fit: contain; }
.professional-login { grid-template-columns: minmax(0, 1.25fr) minmax(360px, 460px); gap: 28px; align-items: stretch; }
.login-showcase { position: relative; min-height: 640px; overflow: hidden; border-radius: 34px; background: #0f172a; box-shadow: 0 28px 70px rgba(2, 6, 23, .32); isolation: isolate; }
.login-showcase::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(2, 6, 23, .82), rgba(15, 23, 42, .42) 44%, rgba(15, 23, 42, .08)); z-index: 1; }
.login-showcase img { width: 100%; height: 100%; object-fit: cover; display: block; transform: scale(1.02); }
.showcase-copy { position: absolute; z-index: 2; left: clamp(22px, 5vw, 58px); top: 50%; transform: translateY(-50%); width: min(560px, calc(100% - 44px)); color: white; }
.showcase-copy h1 { margin: 0; font-size: clamp(34px, 5vw, 64px); line-height: 1.02; letter-spacing: -.05em; }
.showcase-copy p { color: #dbeafe; font-size: 18px; line-height: 1.6; max-width: 520px; }
.showcase-features { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
.showcase-features span { display: inline-flex; align-items: center; gap: 8px; padding: 10px 12px; border-radius: 14px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.18); backdrop-filter: blur(12px); color: #eff6ff; font-weight: 800; }

.app-shell { min-height: 100vh; display: grid; grid-template-columns: 276px 1fr; }
.premium-shell.sidebar-collapsed { grid-template-columns: 92px 1fr; }
.sidebar {
  position: sticky;
  top: 0;
  height: 100vh;
  padding: 22px 18px;
  color: white;
  background: linear-gradient(180deg, rgba(3, 12, 27, .96), rgba(7, 21, 41, .98));
  border-right: 1px solid rgba(148,163,184,.14);
  display: flex;
  flex-direction: column;
  gap: 22px;
  box-shadow: 18px 0 48px rgba(0,0,0,.22);
  z-index: 10;
}
.brand { display: flex; gap: 12px; align-items: center; min-height: 52px; }
.brand-logo { width: 42px; height: 42px; object-fit: contain; border-radius: 12px; background: rgba(255,255,255,.96); padding: 6px; box-shadow: 0 10px 25px rgba(0,0,0,.22); flex: 0 0 auto; }
.brand strong { display: block; font-size: 20px; letter-spacing: -.03em; }
.brand small { display: block; font-size: 11px; line-height: 1.25; color: #8fc9ff; margin-top: 3px; max-width: 170px; }
.brand span { display: block; font-size: 13px; color: #b9c8dc; margin-top: 3px; }
.sidebar-collapsed .brand-text, .sidebar-collapsed .nav span, .sidebar-collapsed .logout span, .sidebar-collapsed .collapse-btn span, .sidebar-collapsed .system-version { display: none; }
.nav { display: grid; gap: 6px; align-content: start; overflow: auto; padding-right: 2px; }
.nav a, .logout, .collapse-btn {
  display: flex;
  align-items: center;
  gap: 11px;
  min-height: 43px;
  padding: 11px 13px;
  border-radius: 14px;
  color: #d8e9ff;
  background: transparent;
  border: 1px solid transparent;
  cursor: pointer;
  font-weight: 750;
  transition: .18s ease;
  white-space: nowrap;
}
.nav a svg, .logout svg, .collapse-btn svg { flex: 0 0 auto; }
.nav a.active, .nav a:hover, .logout:hover, .collapse-btn:hover {
  background: linear-gradient(135deg, rgba(37,99,235,.32), rgba(14,165,233,.12));
  border-color: rgba(96,165,250,.18);
  color: white;
  box-shadow: inset 0 0 0 1px rgba(255,255,255,.04);
}
.sidebar-footer { margin-top: auto; display: grid; gap: 9px; }
.logout, .collapse-btn { width: 100%; }
.system-version { margin-top: 10px; padding: 12px 2px 0; color: var(--muted); font-size: 12px; line-height: 1.55; }
.system-version span, .system-version strong, .system-version small { display: block; }
.system-version strong { color: #dbeafe; }
.main-content { min-width: 0; }
.premium-main { background: linear-gradient(180deg, rgba(3, 13, 29, .48), rgba(3, 9, 20, .1)); }
.topbar {
  position: sticky;
  top: 0;
  z-index: 8;
  min-height: 76px;
  padding: 18px 28px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(3, 13, 29, .82);
  border-bottom: 1px solid rgba(148,163,184,.13);
  backdrop-filter: blur(18px);
}
.topbar-title, .topbar-user { display: flex; align-items: center; gap: 14px; }
.topbar strong, .topbar span { display: block; }
.topbar-title strong { font-size: 18px; }
.topbar-title span, .topbar-user span { color: var(--muted); font-size: 13px; }
.topbar-user { text-align: right; }
.avatar { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; background: linear-gradient(135deg, rgba(37,99,235,.88), rgba(14,165,233,.55)); color: white; font-weight: 900; box-shadow: 0 10px 26px rgba(37,99,235,.28); }
.mobile-menu-btn { display: none; width: 40px; height: 40px; border: 1px solid var(--border); border-radius: 12px; background: rgba(255,255,255,.05); cursor: pointer; }
.mobile-backdrop { display: none; }

.page-section { padding: 24px; display: grid; gap: 20px; }
.page-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.page-header h1 { margin: 0; font-size: clamp(24px, 4vw, 34px); letter-spacing: -.04em; }
.page-header p { margin: 6px 0 0; color: var(--muted); }
.page-header-actions, .export-actions, .actions-cell { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

.panel, .filters-card, .hint-card, .summary-card, .stat-card, .modal-card {
  background: var(--card);
  border: 1px solid var(--card-border);
  border-radius: var(--radius);
  box-shadow: var(--glow);
  backdrop-filter: blur(18px);
}
.panel, .filters-card, .hint-card { padding: 18px; }
.panel h2 { margin: 0 0 14px; font-size: 18px; letter-spacing: -.02em; }
.btn {
  border: 0;
  border-radius: 13px;
  min-height: 42px;
  padding: 11px 16px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  cursor: pointer;
  font-weight: 850;
  transition: .18s ease;
  box-shadow: 0 10px 24px rgba(0,0,0,.16);
}
.btn:disabled, .btn.disabled { opacity: .52; cursor: not-allowed; }
.primary { background: linear-gradient(135deg, #2563eb, #0ea5e9); color: white; }
.primary:hover { filter: brightness(1.1); transform: translateY(-1px); }
.secondary { background: rgba(148,163,184,.12); border: 1px solid rgba(148,163,184,.2); color: #dbeafe; }
.secondary:hover { background: rgba(148,163,184,.18); }
.success, .btn.success { background: linear-gradient(135deg, #16a34a, #22c55e); color: white; }
.warning, .btn.warning { background: linear-gradient(135deg, #d97706, #f59e0b); color: white; }
.danger, .btn.danger { background: linear-gradient(135deg, #dc2626, #ef4444); color: white; }
.link-button { border: 0; background: transparent; color: #7dd3fc; cursor: pointer; font-weight: 800; }
.alert { background: rgba(239,68,68,.13); color: #fecaca; border: 1px solid rgba(239,68,68,.28); padding: 10px; border-radius: 12px; }

.dashboard-hero { display: grid; grid-template-columns: minmax(0, .85fr) minmax(330px, 1.15fr); gap: 0; align-items: stretch; min-height: 285px; overflow: hidden; border-radius: 24px; background: linear-gradient(90deg, rgba(5,17,34,.96), rgba(10,34,63,.88) 42%, rgba(255,255,255,.96) 43%); border: 1px solid rgba(148,163,184,.2); box-shadow: var(--shadow); }
.dashboard-hero-copy { padding: clamp(24px, 4vw, 38px); color: white; display: flex; flex-direction: column; justify-content: center; }
.dashboard-hero-copy h1 { margin: 0; font-size: clamp(28px, 3vw, 40px); line-height: 1.05; letter-spacing: -.05em; max-width: 560px; }
.dashboard-hero-copy p { color: #dbeafe; font-size: 15px; line-height: 1.58; max-width: 620px; }
.hero-logo-panel { position: relative; display: grid; place-items: center; min-height: 260px; overflow: hidden; background: linear-gradient(135deg, #f8fafc, #e7eef7); }
.hero-logo-panel::before, .hero-logo-panel::after { content: ""; position: absolute; width: 280px; height: 280px; transform: rotate(45deg); background: rgba(30,64,175,.06); }
.hero-logo-panel::before { left: -80px; top: 24px; }
.hero-logo-panel::after { right: -90px; bottom: -30px; }
.hero-logo-panel img { width: min(58%, 300px); max-height: 200px; object-fit: contain; position: relative; z-index: 1; filter: drop-shadow(0 16px 22px rgba(15,23,42,.14)); }
.hero-features { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin: 16px 0 6px; max-width: 680px; }
.hero-features span { display: grid; justify-items: center; text-align: center; gap: 7px; padding: 12px 8px; border-radius: 16px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.11); color: #eff6ff; font-size: 12px; font-weight: 800; line-height: 1.2; }
.hero-features svg { color: #93c5fd; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 14px; }
.eyebrow { display: inline-flex; align-items: center; gap: 8px; width: fit-content; margin-bottom: 14px; padding: 8px 12px; border-radius: 999px; background: rgba(37, 99, 235, .14); color: #bfdbfe; border: 1px solid rgba(191, 219, 254, .28); font-weight: 800; font-size: 13px; letter-spacing: .02em; }

.cards-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
.premium-stat-grid { grid-template-columns: repeat(6, minmax(160px, 1fr)); }
.stat-card { padding: 16px; min-height: 116px; display: flex; align-items: center; justify-content: space-between; gap: 14px; overflow: hidden; }
.stat-card span { color: #dbeafe; font-size: 13px; font-weight: 800; }
.stat-card strong { display: block; margin-top: 8px; font-size: clamp(24px, 2vw, 34px); line-height: 1; letter-spacing: -.04em; }
.stat-card small { display: block; margin-top: 7px; color: var(--muted); font-weight: 700; }
.stat-icon { width: 50px; height: 50px; border-radius: 18px; display: grid; place-items: center; color: white; background: rgba(59,130,246,.18); box-shadow: inset 0 0 0 1px rgba(255,255,255,.06); flex: 0 0 auto; }
.stat-success .stat-icon, .stat-card.stat-success .stat-icon { background: rgba(34,197,94,.18); color: #4ade80; }
.stat-warning .stat-icon, .stat-card.stat-warning .stat-icon { background: rgba(245,158,11,.18); color: #fbbf24; }
.stat-danger .stat-icon, .stat-card.stat-danger .stat-icon { background: rgba(239,68,68,.18); color: #fb7185; }
.stat-gold .stat-icon, .stat-card.stat-gold .stat-icon { background: rgba(234,179,8,.18); color: #facc15; }

.dashboard-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px; }
.dashboard-card { grid-column: span 3; min-height: 210px; }
.dashboard-card.wide-card { grid-column: span 5; }
.dashboard-card-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
.dashboard-card-header h2 { margin: 0; font-size: 16px; }
.dashboard-card-header a { color: #60a5fa; font-size: 12px; font-weight: 800; }
.data-table-wrap { margin: -4px -6px 0; }
.responsive-table { width: 100%; overflow-x: auto; }
table { width: 100%; border-collapse: collapse; }
th, td { padding: 12px 10px; border-bottom: 1px solid rgba(148,163,184,.12); text-align: left; vertical-align: middle; }
th { color: #9eb3cc; font-size: 12px; font-weight: 900; }
td { color: #e7eef7; font-size: 13px; }
tbody tr:hover { background: rgba(96,165,250,.06); }
.badge, .mini-badge { padding: 5px 9px; border-radius: 999px; font-size: 11px; font-weight: 900; text-transform: uppercase; letter-spacing: .01em; display: inline-flex; align-items: center; width: fit-content; }
.badge.disponivel, .badge.assinado { background: rgba(34,197,94,.16); color: #86efac; border: 1px solid rgba(34,197,94,.2); }
.badge.em_uso, .badge.enviado, .mini-badge.blue { background: rgba(59,130,246,.16); color: #93c5fd; border: 1px solid rgba(59,130,246,.22); }
.badge.manutencao, .badge.pendente, .mini-badge.orange { background: rgba(245,158,11,.16); color: #fbbf24; border: 1px solid rgba(245,158,11,.22); }
.badge.descartado, .badge.baixado, .badge.recusado, .badge.expirado { background: rgba(239,68,68,.16); color: #fca5a5; border: 1px solid rgba(239,68,68,.22); }

.category-widget { display: grid; grid-template-columns: 120px 1fr; gap: 18px; align-items: center; }
.donut-chart { width: 118px; height: 118px; border-radius: 50%; display: grid; place-items: center; background: conic-gradient(#3b82f6 0 30%, #22c55e 30% 56%, #f59e0b 56% 72%, #ef4444 72% 84%, #8b5cf6 84% 100%); position: relative; }
.donut-chart::after { content: ""; position: absolute; inset: 20px; border-radius: 50%; background: #0d213b; border: 1px solid rgba(255,255,255,.08); }
.donut-chart span, .donut-chart small { position: relative; z-index: 1; display: block; text-align: center; }
.donut-chart span { font-weight: 950; font-size: 22px; }
.donut-chart small { color: var(--muted); font-size: 11px; }
.legend-list, .status-list, .audit-stack, .location-list, .maintenance-list { display: grid; gap: 10px; }
.legend-row { display: grid; grid-template-columns: 12px 1fr auto; align-items: center; gap: 8px; color: #dce8f7; font-size: 13px; }
.legend-row strong { color: #f8fbff; }
.dot { width: 9px; height: 9px; border-radius: 50%; background: #3b82f6; }
.dot-1 { background: #22c55e; } .dot-2 { background: #f59e0b; } .dot-3 { background: #ef4444; } .dot-4 { background: #8b5cf6; } .dot-5 { background: #06b6d4; }
.status-row { display: grid; grid-template-columns: 130px 1fr auto; align-items: center; gap: 12px; font-size: 13px; }
.status-row > div:first-child { display: flex; align-items: center; gap: 8px; color: #dbeafe; }
.status-bar { height: 4px; background: rgba(148,163,184,.18); border-radius: 999px; overflow: hidden; }
.status-bar i { display: block; height: 100%; background: #3b82f6; border-radius: inherit; min-width: 2px; }
.status-row.success .status-bar i { background: var(--success); }
.status-row.warning .status-bar i { background: var(--warning); }
.status-row.danger .status-bar i { background: var(--danger); }
.audit-row, .location-list > div, .maintenance-list > div { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 0; border-bottom: 1px solid rgba(148,163,184,.12); }
.audit-row strong, .maintenance-list strong { display: block; font-size: 13px; }
.audit-row span, .maintenance-list span, .location-list span { color: var(--muted); font-size: 12px; }
.location-list span { display: inline-flex; align-items: center; gap: 6px; }
.location-list strong { font-size: 13px; }
.sector-table { display: grid; gap: 6px; }
.sector-head, .sector-row { display: grid; grid-template-columns: 1.6fr .5fr repeat(4, .8fr); gap: 12px; align-items: center; }
.sector-head { color: var(--muted); font-size: 12px; font-weight: 900; padding-bottom: 8px; border-bottom: 1px solid rgba(148,163,184,.12); }
.sector-row { font-size: 13px; padding: 8px 0; border-bottom: 1px solid rgba(148,163,184,.1); }
.sector-row i { display: inline-block; height: 5px; max-width: 80px; min-width: 8px; border-radius: 999px; background: #3b82f6; margin-right: 6px; vertical-align: middle; }

.filters-card { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: 12px; }
.search-field, .inline-input { display: flex; align-items: center; gap: 8px; background: rgba(2,8,23,.35); border: 1px solid var(--border); border-radius: 14px; padding: 0 10px; }
.search-field input, .inline-input input { border: 0; flex: 1; outline: 0; padding: 12px 0; background: transparent; }
input, select, textarea {
  width: 100%;
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 12px 13px;
  background: rgba(2, 8, 23, .38);
  color: var(--text);
  outline: none;
}
select option { background: #0f1f35; color: white; }
input::placeholder, textarea::placeholder { color: #72839a; }
input:focus, select:focus, textarea:focus { border-color: rgba(96,165,250,.72); box-shadow: 0 0 0 3px rgba(59,130,246,.18); }
.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
.field { display: grid; gap: 7px; }
.field label { font-weight: 800; font-size: 13px; color: #dbeafe; }
.field small { color: var(--muted); font-size: .8rem; }
.field.full, .form-actions.full { grid-column: 1 / -1; }
textarea { min-height: 110px; resize: vertical; }
.field-warning { display: block; margin-top: 0.35rem; color: #fbbf24; font-size: 0.78rem; line-height: 1.2; }

.icon-btn { border: 1px solid rgba(148,163,184,.16); background: rgba(148,163,184,.12); color: #dbeafe; border-radius: 11px; width: 36px; height: 36px; display: inline-grid; place-items: center; cursor: pointer; transition: .18s; }
.icon-btn:hover { background: rgba(96,165,250,.18); color: white; }
.icon-btn.danger { color: #fca5a5; background: rgba(239,68,68,.12); }
.icon-btn.danger:hover:not(:disabled) { color: #fecaca; background: rgba(239,68,68,.22); }
.icon-btn:disabled { opacity: 0.55; cursor: not-allowed; }
.empty-state { padding: 24px; color: var(--muted); text-align: center; }
.premium-empty { min-height: 130px; display: grid; place-items: center; align-content: center; gap: 7px; border: 1px dashed rgba(148,163,184,.22); border-radius: 16px; background: rgba(2,8,23,.18); }
.premium-empty strong { color: #dbeafe; }
.hint-card { display: flex; align-items: center; gap: 10px; color: #fef3c7; background: rgba(245,158,11,.12); border-color: rgba(245,158,11,.28); }
.error-text { color: #fca5a5; }
.success-text { color: #86efac; background: rgba(34,197,94,.12); border: 1px solid rgba(34,197,94,.24); border-radius: 12px; padding: 10px 12px; font-weight: 800; }

.modal-backdrop { position: fixed; inset: 0; background: rgba(2,8,23,.78); display: grid; place-items: center; padding: 20px; z-index: 20; backdrop-filter: blur(8px); }
.modal-card { width: min(100%, 540px); padding: 20px; }
.scanner-box { border-radius: 16px; overflow: hidden; background: #020817; border: 1px solid var(--border); }
.tabs { display: flex; gap: 10px; flex-wrap: wrap; }
.tabs button { border: 1px solid var(--border); background: rgba(148,163,184,.09); color: #dbeafe; border-radius: 999px; padding: 10px 16px; cursor: pointer; font-weight: 800; }
.tabs button.active { background: linear-gradient(135deg, #2563eb, #0ea5e9); color: white; border-color: rgba(96,165,250,.36); }
.settings-form, .user-create-grid { display: grid; grid-template-columns: 1fr 1fr auto; gap: 12px; }
.create-user-panel { display: grid; gap: 1rem; }
.panel-title-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
.panel-title-row h2 { margin: 0; font-size: clamp(1.25rem, 2vw, 1.65rem); }
.panel-title-row p { margin: .35rem 0 0; color: var(--muted); }
.checkbox-field { align-content: end; }
.checkbox-field input[type="checkbox"] { width: 22px; height: 22px; }

.import-help { margin: -6px 0 18px; padding: 14px 16px; border: 1px solid rgba(37,99,235,.24); border-radius: 16px; background: rgba(59,130,246,.08); color: #bfdbfe; font-size: 14px; line-height: 1.55; }
.import-help code { padding: 2px 6px; border-radius: 8px; background: rgba(255,255,255,.08); color: #bfdbfe; font-weight: 800; }
.export-actions label.btn { cursor: pointer; }
.summary-strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.summary-card { padding: 16px; display: grid; gap: 4px; }
.summary-card span { color: var(--muted); font-size: 13px; font-weight: 800; display: inline-flex; align-items: center; gap: 6px; }
.summary-card strong { font-size: clamp(22px, 3vw, 32px); line-height: 1.1; }
.summary-card small { color: var(--muted); line-height: 1.4; }
.summary-card.highlight { background: linear-gradient(135deg, rgba(37,99,235,.18), rgba(255,255,255,.04)); border-color: rgba(37,99,235,.28); }

.qr-filter-notice { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 14px 16px; border: 1px solid rgba(37,99,235,.26); border-radius: 18px; background: rgba(59,130,246,.1); color: #bfdbfe; box-shadow: var(--shadow); }
.qr-filter-notice div { display: grid; gap: 3px; }
.qr-filter-notice strong { color: #dbeafe; }
.qr-filter-notice span { color: #93a9c4; font-size: .92rem; }
.qr-modal-card { width: min(100%, 620px); display: grid; gap: 1rem; }
.qr-preview-box { display: grid; grid-template-columns: 220px 1fr; gap: 1rem; align-items: center; padding: 1rem; border: 1px solid var(--border); border-radius: 18px; background: rgba(2,8,23,.28); }
.qr-preview-box img { width: 220px; height: 220px; object-fit: contain; border-radius: 16px; background: #ffffff; padding: 10px; border: 1px solid var(--border); }
.qr-link-box { display: grid; gap: 8px; }
.qr-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
.feature-image-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
.image-feature-card { position: relative; min-height: 260px; overflow: hidden; border-radius: 24px; border: 1px solid var(--card-border); background: var(--card); box-shadow: var(--shadow); }
.image-feature-card img { width: 100%; height: 100%; min-height: 260px; object-fit: cover; display: block; }
.image-feature-card::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(2,6,23,.08), rgba(2,6,23,.74)); }
.image-feature-card > div { position: absolute; z-index: 1; left: 20px; right: 20px; bottom: 18px; color: white; }
.image-feature-card h3 { margin: 8px 0 4px; font-size: 22px; }
.image-feature-card p { margin: 0; color: #dbeafe; max-width: 520px; }

@media (max-width: 1400px) {
  .premium-stat-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .dashboard-card { grid-column: span 6; }
  .dashboard-card.wide-card { grid-column: span 8; }
}
@media (max-width: 1100px) {
  .app-shell, .premium-shell.sidebar-collapsed { grid-template-columns: 1fr; }
  .sidebar { position: fixed; left: 0; top: 0; bottom: 0; width: 286px; transform: translateX(-102%); transition: .22s ease; }
  .mobile-menu-open .sidebar { transform: translateX(0); }
  .mobile-menu-open .mobile-backdrop { display: block; position: fixed; inset: 0; background: rgba(2,8,23,.62); z-index: 9; }
  .mobile-menu-btn { display: inline-grid; place-items: center; }
  .topbar { padding: 14px 18px; }
  .dashboard-hero { grid-template-columns: 1fr; background: linear-gradient(180deg, rgba(5,17,34,.96), rgba(10,34,63,.88) 54%, rgba(255,255,255,.96) 55%); }
  .hero-features { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .dashboard-card, .dashboard-card.wide-card { grid-column: span 12; }
  .filters-card { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .summary-strip, .feature-image-grid { grid-template-columns: 1fr; }
}
@media (max-width: 720px) {
  .page-section { padding: 16px; gap: 16px; }
  .topbar-user div:first-child { display: none; }
  .page-header { align-items: flex-start; flex-direction: column; }
  .cards-grid, .premium-stat-grid, .filters-card, .form-grid, .settings-form, .user-create-grid { grid-template-columns: 1fr; }
  .dashboard-grid { grid-template-columns: 1fr; }
  .dashboard-card, .dashboard-card.wide-card { grid-column: auto; }
  .hero-features { grid-template-columns: 1fr; }
  .hero-actions .btn { width: 100%; }
  .category-widget { grid-template-columns: 1fr; justify-items: center; }
  .status-row { grid-template-columns: 1fr; }
  .sector-head { display: none; }
  .sector-row { grid-template-columns: 1fr; gap: 6px; padding: 12px; border: 1px solid rgba(148,163,184,.12); border-radius: 14px; }
  .qr-filter-notice { flex-direction: column; align-items: stretch; }
  .qr-preview-box { grid-template-columns: 1fr; justify-items: center; }
  .professional-login { grid-template-columns: 1fr; padding: 16px; }
  .login-showcase { min-height: 560px; border-radius: 24px; }
  .showcase-copy { top: auto; bottom: 22px; transform: none; }
  .showcase-copy p { font-size: 15px; }
  .showcase-features span { width: 100%; }
  table, thead, tbody, th, td, tr { display: block; }
  thead { display: none; }
  tr { border: 1px solid rgba(148,163,184,.13); border-radius: 16px; padding: 10px; margin-bottom: 12px; background: rgba(2,8,23,.18); }
  td { border: 0; display: flex; justify-content: space-between; gap: 12px; padding: 8px; }
  td::before { content: attr(data-label); font-weight: 900; color: var(--muted); }
}

/* Termos premium - tela mais bonita e intuitiva */
.terms-premium-page { gap: 18px; }
.terms-hero {
  padding: 0;
  overflow: hidden;
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(300px, .65fr);
  min-height: 230px;
  background:
    radial-gradient(circle at 12% 12%, rgba(59,130,246,.28), transparent 32%),
    linear-gradient(135deg, rgba(7,20,42,.96), rgba(10,34,63,.85));
}
.terms-hero-copy { padding: clamp(22px, 4vw, 34px); display: flex; flex-direction: column; justify-content: center; }
.terms-hero-copy h1 { margin: 0; font-size: clamp(28px, 4vw, 44px); line-height: 1.03; letter-spacing: -.055em; }
.terms-hero-copy p { margin: 12px 0 0; max-width: 760px; color: #c8dbf3; font-size: 15px; line-height: 1.65; }
.terms-hero-actions { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 10px; }
.terms-hero-stats { padding: 18px; display: grid; align-content: center; gap: 12px; background: linear-gradient(180deg, rgba(255,255,255,.07), rgba(255,255,255,.02)); border-left: 1px solid rgba(148,163,184,.14); }
.terms-mini-stat { padding: 16px; border-radius: 18px; background: rgba(3, 12, 27, .36); border: 1px solid rgba(148,163,184,.15); }
.terms-mini-stat span { color: #bfd4ed; font-size: 12px; font-weight: 850; }
.terms-mini-stat strong { display: block; margin-top: 7px; font-size: 30px; line-height: 1; letter-spacing: -.04em; }
.terms-mini-stat small { display: block; margin-top: 6px; color: var(--muted); font-weight: 700; }
.terms-mini-stat.success strong { color: #4ade80; }
.terms-mini-stat.warning strong { color: #fbbf24; }
.terms-security-note {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  padding: 14px 16px;
  border-radius: 18px;
  background: linear-gradient(135deg, rgba(34,197,94,.13), rgba(14,165,233,.08));
  border: 1px solid rgba(74,222,128,.2);
  color: #d8f8e4;
  box-shadow: inset 0 0 0 1px rgba(255,255,255,.03);
}
.terms-security-note svg { color: #4ade80; flex: 0 0 auto; margin-top: 1px; }
.terms-security-note code { color: #bfdbfe; background: rgba(2,6,23,.28); padding: 2px 6px; border-radius: 7px; }
.terms-workspace { display: grid; grid-template-columns: minmax(0, 1fr) minmax(360px, .64fr); gap: 18px; align-items: start; }
.terms-workspace .terms-form-card:nth-child(2) { grid-row: span 2; }
.terms-submit-card { position: sticky; top: 96px; }
.terms-card-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 18px; }
.terms-card-header h2 { margin: 7px 0 4px; font-size: 20px; letter-spacing: -.035em; }
.terms-card-header h3 { margin: 0; }
.terms-card-header p { margin: 0; color: var(--muted); line-height: 1.45; }
.terms-card-header svg { color: #93c5fd; flex: 0 0 auto; }
.compact-header { margin-bottom: 14px; }
.step-badge { width: 30px; height: 30px; display: inline-grid; place-items: center; border-radius: 12px; background: linear-gradient(135deg, #2563eb, #0ea5e9); color: #fff; font-weight: 950; box-shadow: 0 12px 28px rgba(37,99,235,.27); }
.premium-form-grid label { color: #dbeafe; font-weight: 850; }
.premium-form-grid .span-two { grid-column: 1 / -1; }
.terms-selection-summary { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px; border-radius: 18px; background: rgba(3,12,27,.3); border: 1px solid rgba(148,163,184,.13); margin-bottom: 12px; }
.terms-selection-summary strong { display: block; font-size: 26px; letter-spacing: -.04em; color: #93c5fd; }
.terms-selection-summary span { color: var(--muted); font-size: 13px; font-weight: 800; }
.btn.slim { min-height: 36px; padding: 8px 12px; border-radius: 12px; }
.selected-assets-strip { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
.selected-asset-pill { display: inline-flex; align-items: center; gap: 7px; border: 1px solid rgba(34,197,94,.24); background: rgba(34,197,94,.10); color: #dcfce7; border-radius: 999px; padding: 8px 10px; font-weight: 850; cursor: pointer; }
.selected-asset-pill small { color: #9ce8b5; font-weight: 750; }
.selected-asset-pill:hover { background: rgba(239,68,68,.10); border-color: rgba(239,68,68,.22); }
.selected-more { display: inline-flex; align-items: center; padding: 8px 10px; border-radius: 999px; color: #bfdbfe; background: rgba(59,130,246,.12); border: 1px solid rgba(96,165,250,.18); font-weight: 850; }
.terms-search-field { margin-bottom: 12px; min-height: 46px; }
.premium-assets-list { display: grid; gap: 9px; max-height: 460px; overflow: auto; padding-right: 4px; }
.premium-asset-option { display: grid; grid-template-columns: auto 28px minmax(0, 1fr); align-items: center; gap: 10px; padding: 14px; border-radius: 18px; background: rgba(3,12,27,.28); border: 1px solid rgba(148,163,184,.13); cursor: pointer; transition: .18s ease; }
.premium-asset-option input { width: 17px; height: 17px; accent-color: var(--primary); }
.premium-asset-option:hover { border-color: rgba(96,165,250,.28); background: rgba(59,130,246,.08); transform: translateY(-1px); }
.premium-asset-option.selected { border-color: rgba(34,197,94,.42); background: linear-gradient(135deg, rgba(34,197,94,.15), rgba(14,165,233,.06)); }
.asset-check-ui { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 10px; background: rgba(148,163,184,.1); color: #64748b; }
.premium-asset-option.selected .asset-check-ui { background: rgba(34,197,94,.18); color: #4ade80; }
.asset-option-content { min-width: 0; display: grid; gap: 4px; }
.asset-option-content strong { color: #f8fbff; font-size: 14px; }
.asset-option-content small { color: #9fb2ca; line-height: 1.35; }
.empty-state-mini { padding: 18px; border: 1px dashed rgba(148,163,184,.25); color: var(--muted); border-radius: 16px; text-align: center; }
.terms-checklist { display: grid; gap: 9px; margin-bottom: 14px; }
.terms-checklist span { display: flex; align-items: center; gap: 9px; padding: 10px 12px; border-radius: 14px; color: #9eb3cc; background: rgba(148,163,184,.08); border: 1px solid rgba(148,163,184,.12); font-weight: 850; }
.terms-checklist span.done { color: #dcfce7; background: rgba(34,197,94,.1); border-color: rgba(34,197,94,.18); }
.terms-checklist span.done svg { color: #4ade80; }
.sticky-actions { justify-content: flex-end; border-top: 1px solid rgba(148,163,184,.12); padding-top: 14px; margin-top: 12px; }
.terms-history-card { padding: 18px; }
.table-header-title { margin-bottom: 8px; }
.table-subtext { display: block; color: var(--muted); margin-top: 3px; font-size: 11px; }
.table-action-link { display: inline-flex; align-items: center; gap: 6px; color: #93c5fd; font-weight: 900; }
.table-action-link.whatsapp { color: #86efac; }
.evidence-links { display: flex; flex-wrap: wrap; gap: 8px; }
.evidence-links a { display: inline-flex; align-items: center; min-height: 26px; padding: 5px 8px; border-radius: 999px; color: #bfdbfe; background: rgba(59,130,246,.12); border: 1px solid rgba(96,165,250,.16); font-weight: 850; font-size: 12px; }
.status-badge.assinado { background: rgba(34,197,94,.14); color: #86efac; border-color: rgba(34,197,94,.24); }
.status-badge.enviado, .status-badge.criado, .status-badge.atualizado { background: rgba(59,130,246,.14); color: #93c5fd; border-color: rgba(96,165,250,.24); }
.status-badge.recusado, .status-badge.deletado, .status-badge.expirado { background: rgba(239,68,68,.14); color: #fca5a5; border-color: rgba(239,68,68,.24); }

@media (max-width: 1180px) {
  .terms-workspace, .terms-hero { grid-template-columns: 1fr; }
  .terms-submit-card { position: static; }
  .terms-hero-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); border-left: 0; border-top: 1px solid rgba(148,163,184,.14); }
}
@media (max-width: 720px) {
  .terms-hero-stats, .premium-form-grid { grid-template-columns: 1fr; }
  .premium-form-grid .span-two { grid-column: auto; }
  .premium-asset-option { grid-template-columns: auto minmax(0, 1fr); }
  .premium-asset-option .asset-check-ui { display: none; }
  .terms-security-note { font-size: 13px; }
}

/* Login premium v2.0 - tela corporativa mais intuitiva */
.login-premium-page {
  min-height: 100vh;
  padding: clamp(18px, 2vw, 30px);
  display: grid;
  grid-template-columns: minmax(0, 1.45fr) minmax(380px, .55fr);
  gap: clamp(18px, 2.4vw, 34px);
  align-items: stretch;
  background:
    radial-gradient(circle at 12% 10%, rgba(59, 130, 246, .28), transparent 28%),
    radial-gradient(circle at 88% 90%, rgba(6, 182, 212, .18), transparent 26%),
    linear-gradient(135deg, #020817 0%, #061a33 44%, #0b4f8f 100%);
  color: #f8fbff;
  overflow: hidden;
}
.login-hero-panel {
  position: relative;
  min-height: calc(100vh - clamp(36px, 4vw, 60px));
  border-radius: 34px;
  overflow: hidden;
  border: 1px solid rgba(148, 163, 184, .18);
  box-shadow: 0 32px 90px rgba(1, 8, 20, .42);
  isolation: isolate;
  background:
    linear-gradient(135deg, rgba(5, 15, 31, .96), rgba(9, 35, 72, .95) 54%, rgba(13, 83, 145, .88)),
    radial-gradient(circle at 18% 20%, rgba(59, 130, 246, .22), transparent 24%),
    radial-gradient(circle at 88% 72%, rgba(6, 182, 212, .16), transparent 24%);
}
.login-hero-panel--logo::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(120deg, rgba(255,255,255,.04), transparent 36%),
    linear-gradient(300deg, rgba(255,255,255,.06), transparent 32%);
  z-index: 0;
}
.login-hero-shape {
  position: absolute;
  border-radius: 999px;
  filter: blur(12px);
  opacity: .9;
  z-index: 0;
}
.login-hero-shape-a {
  width: 320px;
  height: 320px;
  top: -80px;
  right: -40px;
  background: radial-gradient(circle, rgba(96, 165, 250, .22), rgba(96, 165, 250, 0));
}
.login-hero-shape-b {
  width: 260px;
  height: 260px;
  bottom: -90px;
  left: -50px;
  background: radial-gradient(circle, rgba(14, 165, 233, .18), rgba(14, 165, 233, 0));
}
.login-hero-shape-c {
  width: 180px;
  height: 180px;
  top: 22%;
  right: 16%;
  background: radial-gradient(circle, rgba(255, 255, 255, .08), rgba(255, 255, 255, 0));
}
.login-hero-content {
  position: relative;
  z-index: 2;
  min-height: 100%;
  width: min(700px, calc(100% - 52px));
  padding: clamp(30px, 4.5vw, 68px);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 18px;
}
.login-pill,
.login-status-dot {
  width: fit-content;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border-radius: 999px;
  border: 1px solid rgba(147, 197, 253, .26);
  background: rgba(147, 197, 253, .14);
  color: #dbeafe;
  font-size: 13px;
  font-weight: 900;
  letter-spacing: -.01em;
  backdrop-filter: blur(12px);
}
.login-hero-brand-mark {
  display: flex;
  align-items: center;
  gap: 18px;
  margin-top: 6px;
}
.login-hero-logo-card {
  width: 126px;
  height: 126px;
  padding: 20px;
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  border-radius: 28px;
  background: rgba(255, 255, 255, .96);
  border: 1px solid rgba(255, 255, 255, .6);
  box-shadow: 0 24px 60px rgba(2, 8, 23, .32);
}
.login-hero-logo-card img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.login-hero-brand-caption {
  display: block;
  margin-bottom: 4px;
  color: #93c5fd;
  font-size: 14px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: .08em;
}
.login-hero-brand-mark strong {
  display: block;
  font-size: clamp(42px, 5vw, 74px);
  line-height: .95;
  letter-spacing: -.07em;
  color: #ffffff;
}
.login-hero-content h1 {
  margin: 0;
  max-width: 640px;
  font-size: clamp(36px, 4.6vw, 64px);
  line-height: 1.02;
  letter-spacing: -.06em;
  color: #ffffff;
  text-shadow: 0 18px 42px rgba(0, 0, 0, .34);
}
.login-hero-content p {
  margin: 0;
  max-width: 580px;
  color: #d7e7fb;
  font-size: clamp(15px, 1.18vw, 19px);
  line-height: 1.65;
}
.login-brand-highlight {
  margin-top: 6px;
  padding: 18px 20px;
  border-radius: 20px;
  width: min(100%, 560px);
  background: linear-gradient(135deg, rgba(15, 23, 42, .78), rgba(30, 64, 175, .26));
  border: 1px solid rgba(147, 197, 253, .22);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .06);
  backdrop-filter: blur(16px);
}
.login-brand-highlight strong {
  display: block;
  font-size: clamp(22px, 2.1vw, 30px);
  line-height: 1.04;
  letter-spacing: -.04em;
  color: #fff;
}
.login-brand-highlight span {
  display: block;
  margin-top: 8px;
  color: #dbeafe;
  font-weight: 750;
}
.login-feature-grid {
  width: min(100%, 640px);
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 10px;
}
.login-feature-card {
  min-height: 82px;
  padding: 14px;
  border-radius: 18px;
  display: flex;
  gap: 12px;
  align-items: flex-start;
  background: rgba(255, 255, 255, .08);
  border: 1px solid rgba(255, 255, 255, .14);
  color: #f8fbff;
  backdrop-filter: blur(16px);
}
.login-feature-card svg {
  color: #93c5fd;
  flex: 0 0 auto;
  margin-top: 2px;
}
.login-feature-card strong {
  display: block;
  font-size: 14px;
  letter-spacing: -.02em;
}
.login-feature-card span {
  display: block;
  margin-top: 4px;
  color: #c7d9ee;
  font-size: 12px;
  line-height: 1.35;
}
.login-form-panel {
  min-height: calc(100vh - clamp(36px, 4vw, 60px));
  display: grid;
  place-items: center;
}
.login-premium-card {
  width: min(100%, 460px);
  padding: clamp(26px, 3.2vw, 42px);
  border-radius: 34px;
  display: grid;
  gap: 18px;
  color: #f8fbff;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, .12), rgba(255, 255, 255, .055)),
    rgba(7, 20, 42, .82);
  border: 1px solid rgba(191, 219, 254, .20);
  box-shadow: 0 34px 90px rgba(1, 8, 20, .42);
  backdrop-filter: blur(22px);
}
.login-logo-card {
  width: 148px;
  height: 64px;
  margin: 0 auto 6px;
  padding: 12px 18px;
  display: grid;
  place-items: center;
  border-radius: 22px;
  background: rgba(255, 255, 255, .96);
  box-shadow: 0 18px 46px rgba(2, 8, 23, .28);
}
.login-logo-card img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.login-card-heading {
  text-align: center;
  display: grid;
  justify-items: center;
  gap: 10px;
  margin-bottom: 2px;
}
.login-card-heading h2 {
  margin: 0;
  font-size: clamp(26px, 2.5vw, 34px);
  letter-spacing: -.055em;
}
.login-card-heading p {
  margin: 0;
  max-width: 340px;
  color: #a9bbd2;
  line-height: 1.55;
}
.login-field-group {
  display: grid;
  gap: 8px;
}
.login-field-group label {
  color: #eaf2ff;
  font-size: 13px;
  font-weight: 900;
}
.login-input-wrap {
  min-height: 58px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 16px;
  border-radius: 18px;
  background: rgba(2, 8, 23, .54);
  border: 1px solid rgba(148, 163, 184, .22);
  transition: .18s ease;
}
.login-input-wrap:focus-within {
  border-color: rgba(96, 165, 250, .75);
  box-shadow: 0 0 0 4px rgba(59, 130, 246, .18);
  background: rgba(2, 8, 23, .72);
}
.login-input-wrap svg {
  color: #8fb2d9;
  flex: 0 0 auto;
}
.login-input-wrap input {
  width: 100%;
  min-width: 0;
  height: 56px;
  color: #f8fbff;
  background: transparent;
  border: 0;
  outline: 0;
}
.login-input-wrap input::placeholder {
  color: #7188a6;
}
.login-eye-btn {
  width: 36px;
  height: 36px;
  border-radius: 12px;
  border: 1px solid rgba(148, 163, 184, .16);
  background: rgba(255, 255, 255, .06);
  color: #dbeafe;
  display: grid;
  place-items: center;
  cursor: pointer;
  transition: .18s ease;
}
.login-eye-btn:hover {
  background: rgba(59, 130, 246, .18);
  border-color: rgba(96, 165, 250, .32);
}
.login-submit-btn {
  min-height: 60px;
  margin-top: 6px;
  border: 0;
  border-radius: 18px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  color: #fff;
  font-weight: 950;
  letter-spacing: -.02em;
  background: linear-gradient(135deg, #2563eb, #0ea5e9);
  box-shadow: 0 18px 42px rgba(37, 99, 235, .34);
  transition: .18s ease;
}
.login-submit-btn:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 22px 52px rgba(37, 99, 235, .46);
}
.login-submit-btn:disabled {
  cursor: wait;
  opacity: .72;
}
.login-forgot-btn {
  justify-self: center;
  border: 0;
  background: transparent;
  color: #7dd3fc;
  font-weight: 900;
  cursor: pointer;
}
.login-forgot-btn:hover {
  color: #bae6fd;
}
.login-alert {
  padding: 12px 14px;
  border-radius: 16px;
  background: rgba(245, 158, 11, .12);
  border: 1px solid rgba(245, 158, 11, .26);
  color: #fde68a;
  font-size: 13px;
  font-weight: 750;
  line-height: 1.4;
}
.login-security-note {
  margin-top: 4px;
  padding: 12px 14px;
  border-radius: 16px;
  display: flex;
  gap: 10px;
  align-items: flex-start;
  color: #b9cbe2;
  background: rgba(34, 197, 94, .08);
  border: 1px solid rgba(34, 197, 94, .16);
  font-size: 12px;
  line-height: 1.45;
}
.login-security-note svg {
  flex: 0 0 auto;
  color: #4ade80;
  margin-top: 1px;
}
